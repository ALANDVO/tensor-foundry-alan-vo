# Environment configuration for TensorFoundry

# Application Environment (production, staging, development)
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Local Demo Mode (binds localhost only; strictly refused in production)
DEMO_MODE=true

# Database Configuration (SQLite parameterized/SQLAlchemy)
DATABASE_URL=sqlite:///./tensor_foundry.db

# Authentication & Keycloak OIDC Settings
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/tensor-foundry
OIDC_AUDIENCE=tensor-foundry-api
OIDC_CLIENT_ID=tensor-foundry-client
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/tensor-foundry/protocol/openid-connect/certs
OIDC_TOKEN_URL=http://127.0.0.1:8080/realms/tensor-foundry/protocol/openid-connect/token

# Demo Token Signing Secret (for local offline demo mode only; never use in production)
DEMO_JWT_SECRET=local-development-demo-secret-key-change-in-env

# Advisory LLM Configuration (Opt-in advisory analysis; server-side only; blank credential)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_OIDC_AUTHORITY=http://127.0.0.1:8080/realms/tensor-foundry
VITE_OIDC_CLIENT_ID=tensor-foundry-client
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
